%================================================================ PUBLIKASI ILMIAH
\newcommand{\sistematikapublikasi}{%
  \ifunnesrepositori
    %---------------------------------------- versi repositori perpustakaan (hal. 59)
    \chapter{TAUTAN DAN KETERANGAN PUBLIKASI}
    \unnescatatan{Panduan hal. 59: naskah untuk repositori UNNES dikirim TANPA mencantumkan isi
      artikel. Isi bagian ini hanya tautan dan keterangan penerbitan.}
    \section{Tautan Homepage Jurnal}
    \unnescatatan{Panduan hal. 59: tautan (a) homepage jurnal dan (b) URL artikel bagi artikel
      yang sudah terbit.}
    \section{Keterangan Acceptance}
    \unnescatatan{Panduan hal. 59: nama jurnal, tautan homepage jurnal, keterangan volume, nomor,
      tahun akan terbit, dan bukti accepted (LoA). Bagian ini dikosongkan bila artikel sudah terbit.}
  \else
    \ifunnesproposal
      %------------------------------------------- proposal artikel ilmiah (hal. 57-58)
      \chapter{PENDAHULUAN}
      \section{Latar Belakang}
      \section{Rumusan Masalah}
      \unnescatatan{Panduan hal. 57: research question ditulis singkat, padat, dan sistematis.
        Panduan menomori subbab ini 1.2 lalu melompat ke 1.4, 1.5, dan 1.6 (tanpa 1.3);
        template memakai penomoran berurutan.}
      \section{Tujuan}
      \unnescatatan{Panduan hal. 57: pastikan tujuan terjawab di abstrak, pembahasan, dan simpulan.}
      \section{Manfaat}
      \section{Kebaruan}
      \chapter{TINJAUAN PUSTAKA}
      \unnescatatan{Panduan hal. 58: petakan dan nilai area penelitian untuk menyadarkan urgensi
        serta membenarkan pertanyaan ilmiah; utamakan pustaka dari jurnal bereputasi.}
      \chapter{METODE}
      \unnescatatan{Panduan hal. 58: subbab pada bab ini ditentukan dosen pembimbing bersama
        mahasiswa sesuai kebutuhan dan karakteristik studi, sehingga tidak dibakukan template.}
    \else
      %--------------------- laporan untuk ujian: naskah artikel jurnal (hal. 58)
      \chapter{NASKAH ARTIKEL ILMIAH}
      \unnescatatan{Panduan hal. 58: bagian utama laporan publikasi ilmiah adalah naskah artikel
        yang telah terbit atau accepted, disusun menurut template manuskrip jurnal tujuan, bukan
        sistematika bab skripsi. Lampirkan LoA, tautan jurnal, dan bukti korespondensi (hal. 59).}
    \fi
  \fi
}

