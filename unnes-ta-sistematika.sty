%% unnes-ta-sistematika.sty — kerangka bab dan subbab per jenis tugas akhir
%% Sumber sistematika (Panduan TA Sarjana dan Diploma UNNES 2024):
%%   skripsi            : proposal hal. 14-16, laporan hal. 16-18
%%   proyek             : proposal hal. 29-31, laporan hal. 31-32
%%   prototipe          : proposal hal. 43-45, laporan hal. 45-46
%%   publikasi ilmiah   : proposal hal. 57-58, laporan hal. 58, versi repositori hal. 59
%%   penyetaraan        : laporan hal. 72-74 (tidak perlu proposal, hal. 8)
%%
%% Pemakaian di dokumen:
%%   \sistematika                      % otomatis memilih sesuai opsi kelas jenis=... mode=...
%%   \sistematikaskripsi               % atau panggil jenis tertentu langsung
%%
%% Subbab bertanda "bila ada" pada panduan dicetak hanya jika diaktifkan, dengan opsi kelas
%% opsional (semua sekaligus) atau saklar per subbab:
%%   \documentclass[opsional]{unnes-ta}      % seluruh subbab "bila ada" ikut dicetak
%%   \unnesopskerangkaberpikirtrue           % hanya subbab ini yang diaktifkan
%% Catatan panduan di bawah setiap judul dapat dimatikan dengan opsi kelas catatan=false
%% atau perintah \unnescatatanfalse.
%%
%% Penyimpangan yang disengaja dari panduan (dan alasannya):
%%   1. Nomor subbab mengikuti penomoran otomatis LaTeX. Panduan menulis daftar subbab proposal
%%      publikasi sebagai 1.1, 1.2, 1.4, 1.5, 1.6 (tanpa 1.3), laporan proyek sebagai 2.3/2.4,
%%      dan laporan prototipe sebagai 2.5/2.6; nomor itu tidak diteruskan agar tidak ada lompatan.
%%   2. Penyetaraan prestasi pada panduan hal. 73 menomori bab terakhir sebagai "BAB III" padahal
%%      itu bab keempat; template memakai BAB 4.
%%   3. Ejaan judul subbab diseragamkan ("Latar Belakang", "Rumusan Masalah") karena panduan
%%      menulis sebagian dengan huruf kecil ("Latarbelakang", "Rumusan masalah").

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{unnes-ta-sistematika}[2026/09/20 v0.4 Kerangka bab per jenis TA]

\RequirePackage{etoolbox}

%===================================================== saklar subbab "bila ada"
\newif\ifunnesopsbatasanmasalah
\newif\ifunnesopskerangkaberpikir
\newif\ifunnesopshipotesisteoretis
\newif\ifunnesopsvariabel
\newif\ifunnesopshipotesisstatistik
\newif\ifunnesopsetika

% \unnesops{nama}{kode} — mencetak kode bila opsi kelas opsional aktif ATAU saklar nama aktif.
% Pengecekan saklar dipisah ke makro sendiri supaya pasangan \if...\else\fi selalu berimbang:
% menaruh \@nameuse{if...} langsung di cabang \else membuat \fi berlebih (Extra \fi).
\newcommand{\unnesopscek}[2]{\@nameuse{ifunnesops#1}#2\else\fi}
\newcommand{\unnesops}[2]{%
  \ifunnesopsional
    #2%
  \else
    \unnesopscek{#1}{#2}%
  \fi
}

%=================================================================== catatan panduan
% Catatan pengarah di bawah judul subbab; hilang dengan opsi kelas catatan=false.
\newcommand{\unnescatatan}[1]{%
  \ifunnescatatan
    \par\vspace{-0.3\baselineskip}%
    \begingroup\setstretch{1.0}\footnotesize\itshape
      \noindent\hspace*{0.8cm}\parbox{\dimexpr\textwidth-1.6cm\relax}{\raggedright #1}%
    \par\endgroup
    \vspace{0.3\baselineskip}%
  \fi
}

%========================================================================= SKRIPSI
\newcommand{\sistematikaskripsi}{%
  %--------------------------------------------------------------- BAB 1 (hal. 14-15)
  \chapter{PENDAHULUAN}
  \section{Latar Belakang}
  \unnescatatan{Panduan hal. 14: alasan mengapa masalah menarik, penting, dan perlu diteliti;
    kemukakan fenomena nyata, penelitian terdahulu, kesenjangan, dan state of the art.}
  \unnesops{batasanmasalah}{%
    \section{Batasan Masalah}
    \unnescatatan{Panduan hal. 14: batasan masalah (bila ada).}}
  \section{Rumusan Masalah}
  \unnescatatan{Panduan hal. 14: rumusan masalah ditulis singkat, padat, dan sistematis.}
  \section{Tujuan Penelitian}
  \unnescatatan{Panduan hal. 14-15: menyatakan upaya penyelesaian masalah (mengetahui,
