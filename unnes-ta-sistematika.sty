  \chapter{KAJIAN PUSTAKA}
  \section{Tinjauan Pustaka}
  \unnescatatan{Panduan hal. 15: rangkaian hasil penelitian lain yang menjadi landasan
    penelitian, bukan sekadar kumpulan hasil penelitian.}
  \section{Landasan Teoretik}
  \unnescatatan{Panduan hal. 15: konstruksi teori atau konsep yang mendasari pembahasan.}
  \unnesops{kerangkaberpikir}{%
    \section{Kerangka Berpikir}
    \unnescatatan{Panduan hal. 15: kerangka berpikir (bila ada).}}
  \unnesops{hipotesisteoretis}{%
    \section{Hipotesis Teoretis}
    \unnescatatan{Panduan hal. 15: hipotesis teoretis (bila ada).}}
  %----------------------------------------------------------------- BAB 3 (hal. 15-16)
  \chapter{METODE PENELITIAN}
  \section{Pendekatan, Jenis, dan Prosedur Penelitian}
  \unnescatatan{Panduan hal. 15-16: sertakan desain penelitian, tahapan, prosedur, luaran,
    dan indikator capaian yang terukur.}
  \section{Lokasi dan Waktu Penelitian}
  \section{Subjek Penelitian/Sampel dan Populasi}
  \unnesops{variabel}{%
    \section{Variabel Penelitian dan Definisi Operasional}
    \unnescatatan{Panduan hal. 16: variabel penelitian dan definisi operasional (bila ada).}}
  \unnesops{hipotesisstatistik}{%
    \section{Hipotesis Statistik}
    \unnescatatan{Panduan hal. 16: hipotesis statistik (bila ada).}}
  \section{Data dan Sumber Data}
  \section{Teknik Pengumpulan Data}
  \unnescatatan{Panduan hal. 16: untuk metode survei lampirkan kuesioner lengkap sebagai lampiran.}
  \section{Teknik Keabsahan Data}
  \section{Teknik Analisis Data}
  \unnesops{etika}{%
    \section{Etika Penelitian}
    \unnescatatan{Panduan hal. 16: etika penelitian (bila ada).}}
  %------------------------------------------ laporan: BAB 4 dan BAB 5 (hal. 18)
  \ifunneslaporan
    \chapter{HASIL DAN PEMBAHASAN}
    \unnescatatan{Panduan hal. 18: sajikan data hasil penelitian lalu bahas dengan teori yang
      digunakan; tabel dan gambar harus berurutan penampilannya (hal. 90-91).}
    \chapter{PENUTUP}
    \section{Simpulan}
    \unnescatatan{Panduan hal. 5.1: jawaban atas tujuan penelitian.}
    \section{Saran}
    \unnescatatan{Panduan hal. 5.2: saran bagi pihak terkait dan penelitian lanjutan.}
  \fi
}

