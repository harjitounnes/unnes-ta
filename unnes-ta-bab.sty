%% unnes-ta-bab.sty — judul bab/subbab dan nama bagian berbahasa Indonesia
%% Panduan TA UNNES 2024 tidak mengatur bentuk judul bab (keputusan desain template):
%%   judul bab  : "BAB 1." pada baris pertama, nama bab HURUF KAPITAL pada baris kedua, rata tengah, tebal
%%   subbab     : "1.1 Nama Subbab", rata kiri, tebal, 12 pt
%% Nama bagian dipasang lewat \addto\captionsenglish supaya tidak ditimpa babel saat \begin{document}.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{unnes-ta-bab}[2026/09/20 v0.1 Judul bab dan subbab]

\RequirePackage{textcase}
\RequirePackage{etoolbox}

%================================================== nama bagian berbahasa Indonesia
\ifdefstring{\unnes@bahasa}{id}{%
  \addto\captionsenglish{%
    \renewcommand{\contentsname}{DAFTAR ISI}%
